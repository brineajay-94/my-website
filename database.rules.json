{
  "rules": {

    /* ─────────── SUPPORT CHAT SYSTEM ─────────── */

    "support": {

      "chats": {
        /* List all chats: only superadmin via email */
        ".read": "auth != null && auth.token.email != null && auth.token.email.lower() === 'ajaykafle254@gmail.com'",
        ".indexOn": "lastTimestamp",

        "$chatId": {
          /* Owner by UID, or superadmin by email */
          ".read": "auth != null && (auth.uid === $chatId || (auth.token.email != null && auth.token.email.lower() === 'ajaykafle254@gmail.com'))",

          ".write": "auth != null && (auth.uid === $chatId || (auth.token.email != null && auth.token.email.lower() === 'ajaykafle254@gmail.com'))",

          ".validate": "newData.hasChildren(['userId', 'userName', 'userEmail']) && newData.child('userId').val() === $chatId",

          "userId": { ".validate": "newData.isString() && newData.val() === $chatId" },
          "userName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "userEmail": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "lastMessage": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "lastTimestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "unreadAdmin": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "unreadUser": { ".validate": "newData.isNumber() && newData.val() >= 0" },

          "messages": {
            ".indexOn": "timestamp",

            "$messageId": {
              ".validate": "newData.hasChildren(['sender', 'senderName', 'text', 'timestamp', 'seen'])",

              "sender": {
                ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === 'admin')"
              },
              "senderName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
              "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
              "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "seen": { ".validate": "newData.isBoolean()" }
            }
          }
        }
      }
    }
  }
}
