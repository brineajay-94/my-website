rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ─────────── HELPERS ─────────── */
    function isAdminEmail(email) {
      return email != null && email.lower() == 'ajaykafle254@gmail.com';
    }

    function requesterIsSuperAdmin() {
      return request.auth != null && isAdminEmail(request.auth.token.email);
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    /* ─────────── USERS ─────────── */
    match /users/{userId} {

      allow create: if isLoggedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role in ['user', 'admin', 'superadmin']
                    && request.resource.data.keys().hasAll(['fullName', 'email', 'role', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.fullName is string;

      allow read: if isOwner(userId)
                  || requesterIsSuperAdmin()
                  || resource.data.role != 'superadmin';

      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fullName', 'contactNumber', 'isVerified', 'verifiedAt']))
                     || requesterIsSuperAdmin();

      allow delete: if requesterIsSuperAdmin();
    }

    /* ─────────── WEBSITES ─────────── */
    match /websites/{website} {

      allow create: if requesterIsSuperAdmin()
                    && request.resource.data.keys().hasAll(['userId', 'siteName', 'siteUrl', 'createdAt'])
                    && request.resource.data.siteName is string
                    && request.resource.data.siteUrl is string
                    && request.resource.data.userId is string;

      allow read: if isLoggedIn()
                  && (resource.data.userId == request.auth.uid || requesterIsSuperAdmin());

      allow update: if requesterIsSuperAdmin();

      allow delete: if requesterIsSuperAdmin();
    }

    /* ─────────── PLANS ─────────── */
    match /plans/{plan} {

      allow create: if requesterIsSuperAdmin()
                    && request.resource.data.keys().hasAll(['name', 'price', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.price is number;

      allow read: if resource.data.isActive == true || requesterIsSuperAdmin();

      allow update: if requesterIsSuperAdmin();

      allow delete: if requesterIsSuperAdmin();
    }

    /* ─────────── ACTIVITY LOG ─────────── */
    match /activity/{entry} {
      allow create: if requesterIsSuperAdmin();
      allow read: if requesterIsSuperAdmin();
      allow update: if false;
      allow delete: if requesterIsSuperAdmin();
    }

    /* ─────────── IP WHITELIST SECURITY ─────────── */
    match /security/{doc} {
      allow read: if isLoggedIn();
      allow write: if requesterIsSuperAdmin();
    }

    match /allowed_ips/{ipDoc} {
      allow read: if isLoggedIn();
      allow create: if requesterIsSuperAdmin()
                    && request.resource.data.keys().hasAll(['ip', 'createdAt'])
                    && request.resource.data.ip is string
                    && request.resource.data.ip.matches('^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$');
      allow update: if requesterIsSuperAdmin();
      allow delete: if requesterIsSuperAdmin();
    }

    match /access_logs/{log} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if requesterIsSuperAdmin();
      allow update: if false;
    }

    match /audit_logs/{log} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if requesterIsSuperAdmin();
      allow update: if false;
    }
  }
}
